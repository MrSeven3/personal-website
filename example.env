KOMODO_API_KEY=replace_me_replace_me_replace_me
KOMODO_API_SECRET=replace_me_replace_me_replace_me
KOMODO_QUERY_ENDPOINT="komodo.example.com"

GRAFANA_API_KEY=replace_me_replace_me_replace_me
GRAFANA_QUERY_ENDPOINT="https://grafana.example.com/api/datasources/uid/replace_me/resources/api/v1/query?query=avg_over_time(monitor_status%7Bmonitor_name%3D%22Personal%20Website%22%7D%5B30d%5D)"
#above is an example endpoint, configure to match whatever you want to query for uptime

OAUTH_DOMAIN="auth.example.com"
OAUTH_CLIENT_ID=replace_me
OAUTH_CLIENT_SECRET="replace_me"
OAUTH_REDIRECT_URI="http://example.com/admin/login/oauth" #keep the path of this, as thats the callback i have configured in routing

APP_DOMAIN="example.com" # whatever domain youre serving the app on

FLASK_SECRET_KEY="this_one_you_absolutely_need_to_replace" # use like `openssl rand -base64 32` to generate it

SENTRY_DSN="67823478691234.example.com" #if for some reason you want sentry error reporting on my website, uh fill this out ig
